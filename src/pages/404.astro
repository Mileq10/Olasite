---
import Layout from '../layouts/Layout.astro';
import { SITE_NAME } from '../lib/site.js';
---

<Layout
  title={`Strona nie istnieje | ${SITE_NAME}`}
  description="Nie znaleziono tej strony. Wróć na stronę główną Obiektyw na Szczęście."
  noindex={true}
>
  <div class="privacy-page">
    <div class="section-inner">
      <h1>Nie znaleziono strony</h1>
      <p class="section-lead">Ten adres nie istnieje albo galeria została przeniesiona.</p>
      <a class="gallery-back" href="/">← Wróć na stronę główną</a>
    </div>
  </div>
</Layout>
