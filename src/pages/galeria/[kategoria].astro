---
import Layout from '../../layouts/Layout.astro';
import InstagramLink from '../../components/InstagramLink.astro';
import { SITE_NAME, galleries, listPhotos } from '../../lib/site.js';

export function getStaticPaths() {
  return Object.keys(galleries).map((kategoria) => ({ params: { kategoria } }));
}

const { kategoria } = Astro.params;
const gallery = galleries[kategoria] || galleries.biznesowa;
const photos = gallery.folder ? listPhotos(gallery.folder) : [];
const backHref = gallery.parent ? `/galeria/${gallery.parent}` : '/#portfolio';
const backLabel = gallery.parent ? 'Wróć do reportaży' : 'Wróć do kategorii';
const eyebrow = gallery.parent ? galleries[gallery.parent].title : 'Portfolio';
const lead =
  gallery.description ||
  (gallery.type === 'hub'
    ? 'Wybierz rodzaj reportażu, żeby zobaczyć zdjęcia.'
    : 'Kliknij zdjęcie, aby powiększyć. Strzałkami lub gestem przejdziesz dalej.');
const description =
  gallery.description || `${gallery.title} — galeria zdjęć | ${SITE_NAME}`;
const image =
  gallery.type === 'hub'
    ? gallery.children[0]?.image
    : photos[0]?.src || `/zdjecia/portfolio/${gallery.folder}/okladka.jpg`;
const origin = Astro.site ?? Astro.url;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: new URL('/', origin).href },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: new URL('/#portfolio', origin).href },
    ...(gallery.parent
      ? [
          {
            '@type': 'ListItem',
            position: 3,
            name: galleries[gallery.parent].title,
            item: new URL(`/galeria/${gallery.parent}`, origin).href
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: gallery.title,
            item: new URL(`/galeria/${kategoria}`, origin).href
          }
        ]
      : [
          {
            '@type': 'ListItem',
            position: 3,
            name: gallery.title,
            item: new URL(`/galeria/${kategoria}`, origin).href
          }
        ])
  ]
};
---

<Layout title={`${gallery.title} | ${SITE_NAME}`} description={description} image={image} jsonLd={jsonLd}>
  <div class="gallery-page">
    <div class="section-inner">
      <a class="gallery-back" href={backHref}>
        <span aria-hidden="true">←</span>
        {backLabel}
      </a>
      <header class="gallery-intro">
        <p class="gallery-eyebrow">{eyebrow}</p>
        <h1 class="gallery-title">{gallery.title}</h1>
        <p class="gallery-lead">{lead}</p>
      </header>

      {gallery.type === 'hub' ? (
        <div class="categories-grid">
          {gallery.children.map((child) => (
            <article class="category-card">
              <a href={`/galeria/${child.key}`} class="category-image">
                <img src={child.image} alt={child.title} />
                <span class="category-caption">
                  <span class="category-name">{child.title}</span>
                  <span class="category-hint">Zobacz galerię</span>
                </span>
              </a>
            </article>
          ))}
        </div>
      ) : photos.length ? (
        <div class="photos-grid" data-lightbox>
          {photos.map((photo, index) => (
            <button
              type="button"
              class:list={['mosaic-item', photo.orientation === 'landscape' && 'is-landscape']}
              data-index={index}
              aria-label={`Powiększ zdjęcie ${index + 1} z ${photos.length}`}
            >
              <img src={photo.src} alt={`${gallery.title} — zdjęcie ${index + 1}`} />
            </button>
          ))}
        </div>
      ) : (
        <p class="section-lead">Brak zdjęć w folderze. Wrzuć pliki do public/zdjecia/portfolio/{gallery.folder}/</p>
      )}

      <section class="more-photos">
        <h2>Więcej zdjęć?</h2>
        <p>Kolejne realizacje wrzucam na Instagram — zajrzyj, jeśli chcesz zobaczyć więcej kadrów.</p>
        <InstagramLink class="instagram-link more-photos-link" />
      </section>
    </div>
  </div>

  {photos.length > 0 && (
    <div class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Podgląd zdjęcia">
      <button type="button" class="lightbox-close" aria-label="Zamknij podgląd">
        <span aria-hidden="true">×</span>
      </button>
      <button type="button" class="lightbox-prev" aria-label="Poprzednie zdjęcie">
        <span aria-hidden="true">‹</span>
      </button>
      <figure class="lightbox-stage">
        <img class="lightbox-image" alt="" />
        <figcaption class="lightbox-counter"></figcaption>
      </figure>
      <button type="button" class="lightbox-next" aria-label="Następne zdjęcie">
        <span aria-hidden="true">›</span>
      </button>
    </div>
  )}
</Layout>

<script>
  import { initLightbox } from '../../scripts/lightbox.js';
  initLightbox();
</script>
