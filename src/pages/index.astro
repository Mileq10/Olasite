---
import Layout from '../layouts/Layout.astro';
import InstagramLink from '../components/InstagramLink.astro';
import {
  SITE_NAME,
  DEFAULT_DESCRIPTION,
  EMAIL_TO,
  PHONE,
  PHONE_LABEL,
  INSTAGRAM_URL
} from '../lib/site.js';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE_NAME,
    description: DEFAULT_DESCRIPTION,
    url: Astro.site?.href,
    email: EMAIL_TO,
    telephone: PHONE,
    image: new URL('/zdjecia/hero/tlo.jpg', Astro.site ?? Astro.url).href,
    sameAs: [INSTAGRAM_URL],
    areaServed: 'PL',
    serviceType: ['Fotografia portretowa', 'Fotografia biznesowa', 'Reportaż']
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: Astro.site?.href,
    inLanguage: 'pl-PL'
  }
];
---

<Layout
  title={`Fotografia portretowa, biznesowa i reportażowa | ${SITE_NAME}`}
  description={DEFAULT_DESCRIPTION}
  jsonLd={jsonLd}
>
  <section class="hero-section" id="home">
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Przeżywaj wspaniałe chwile, i pozwól mi je uwiecznić.</h1>
          <p>
            To jest tekst placeholderowy aby zapełnić trochę przestrzeni i pokazać jak mogłoby to wyglądać gdyby np było tu coś o typie sesji i dlaczego akurat ktoś chciałby wykupić u ciebie tą sesję, wiesz o co chodzi.
          </p>
          <div class="hero-buttons">
            <a href="#kontakt" class="btn btn-primary">Umów się na sesję</a>
            <a href="#portfolio" class="btn btn-secondary">Zobacz więcej zdjęć</a>
          </div>
        </div>
        <div class="hero-gallery">
          <div class="gallery-item item-1">
            <img src="/zdjecia/hero/1.jpg" alt="Sesja rodzinna" />
          </div>
          <div class="gallery-item item-2">
            <img src="/zdjecia/hero/2.jpg" alt="Portret kobiety" />
          </div>
          <div class="gallery-item item-3">
            <img src="/zdjecia/hero/3.jpg" alt="Kobieta w ogrodzie" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="categories-section" id="portfolio">
    <div class="section-inner">
      <h2 class="section-title">Portfolio</h2>
      <p class="section-lead">Wybierz kategorię, żeby zobaczyć zdjęcia z sesji i reportaży.</p>
      <div class="portfolio-block">
        <p class="block-label">Kategorie sesji</p>
        <div class="categories-grid">
          <article class="category-card">
            <a href="/galeria/biznesowa" class="category-image">
              <img src="/zdjecia/portfolio/biznesowa/okladka.jpg" alt="Sesja biznesowa" />
              <span class="category-caption">
                <span class="category-name">Sesja biznesowa</span>
                <span class="category-hint">Zobacz galerię</span>
              </span>
            </a>
          </article>
          <article class="category-card">
            <a href="/galeria/portretowa" class="category-image">
              <img src="/zdjecia/portfolio/portretowa/okladka.jpg" alt="Sesja portretowa" />
              <span class="category-caption">
                <span class="category-name">Sesja portretowa</span>
                <span class="category-hint">Zobacz galerię</span>
              </span>
            </a>
          </article>
          <article class="category-card">
            <a href="/galeria/wydarzenia" class="category-image">
              <img src="/zdjecia/portfolio/wydarzenia/okladka.jpg" alt="Reportaże z wydarzeń" />
              <span class="category-caption">
                <span class="category-name">Reportaże z wydarzeń</span>
                <span class="category-hint">Zobacz galerię</span>
              </span>
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section offer-section" id="oferta">
    <div class="section-inner">
      <h2 class="section-title">Oferta</h2>
      <p class="section-lead">Stałe pakiety na sesje portretowe i biznesowe. Reportaże wyceniam indywidualnie w podanych widełkach.</p>

      <div class="offer-category">
        <button type="button" class="offer-category-head" aria-expanded="false">
          <span class="block-label">Portret</span>
          <span class="offer-category-title">Sesja portretowa</span>
          <span class="offer-toggle" aria-hidden="true"></span>
        </button>
        <div class="offer-category-body">
          <div class="offer-grid">
            <article class="offer-card">
              <p class="block-label">Mini</p>
              <p class="offer-price">400 zł</p>
              <ul>
                <li>1 godzina zdjęć</li>
                <li>15 wyretuszowanych zdjęć</li>
                <li>1 lokalizacja</li>
                <li>Galeria online</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="portretowa" data-pakiet="mini">
                <span class="btn-text-long">Zapytaj o ten pakiet</span>
                <span class="btn-text-short">Wybierz</span>
              </a>
            </article>
            <article class="offer-card offer-card--featured">
              <span class="offer-badge">Najczęściej wybierany</span>
              <p class="block-label">Standard</p>
              <p class="offer-price">750 zł</p>
              <ul>
                <li>2 godziny zdjęć</li>
                <li>40 wyretuszowanych zdjęć</li>
                <li>Do 2 lokalizacji</li>
                <li>Konsultacja stylizacji</li>
              </ul>
              <a href="#kontakt" class="btn btn-primary js-fill-form" data-tematyka="portretowa" data-pakiet="standard">
                <span class="btn-text-long">Zapytaj o ten pakiet</span>
                <span class="btn-text-short">Wybierz</span>
              </a>
            </article>
            <article class="offer-card">
              <p class="block-label">Premium</p>
              <p class="offer-price">1200 zł</p>
              <ul>
                <li>3 godziny zdjęć</li>
                <li>80 wyretuszowanych zdjęć</li>
                <li>Kilka aranżacji</li>
                <li>Priorytetowa edycja</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="portretowa" data-pakiet="premium">
                <span class="btn-text-long">Zapytaj o ten pakiet</span>
                <span class="btn-text-short">Wybierz</span>
              </a>
            </article>
          </div>
        </div>
      </div>

      <div class="offer-category">
        <button type="button" class="offer-category-head" aria-expanded="false">
          <span class="block-label">Biznes</span>
          <span class="offer-category-title">Sesja biznesowa</span>
          <span class="offer-toggle" aria-hidden="true"></span>
        </button>
        <div class="offer-category-body">
          <div class="offer-grid">
            <article class="offer-card">
              <p class="block-label">Mini</p>
              <p class="offer-price">450 zł</p>
              <ul>
                <li>1 godzina zdjęć</li>
                <li>10 zdjęć do LinkedIn / strony</li>
                <li>1 tło lub lokalizacja</li>
                <li>Wersje kolor i czarno-białe</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="biznesowa" data-pakiet="mini">
                <span class="btn-text-long">Zapytaj o ten pakiet</span>
                <span class="btn-text-short">Wybierz</span>
              </a>
            </article>
            <article class="offer-card offer-card--featured">
              <span class="offer-badge">Najczęściej wybierany</span>
              <p class="block-label">Standard</p>
              <p class="offer-price">850 zł</p>
              <ul>
                <li>2 godziny zdjęć</li>
                <li>30 zdjęć indywidualnych lub zespołowych</li>
                <li>2 aranżacje</li>
                <li>Pliki do druku i social mediów</li>
              </ul>
              <a href="#kontakt" class="btn btn-primary js-fill-form" data-tematyka="biznesowa" data-pakiet="standard">
                <span class="btn-text-long">Zapytaj o ten pakiet</span>
                <span class="btn-text-short">Wybierz</span>
              </a>
            </article>
            <article class="offer-card">
              <p class="block-label">Premium</p>
              <p class="offer-price">1400 zł</p>
              <ul>
                <li>3 godziny zdjęć</li>
                <li>60 zdjęć marki / zespołu</li>
                <li>Kilka lokalizacji</li>
                <li>Konsultacja wizerunkowa</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="biznesowa" data-pakiet="premium">
                <span class="btn-text-long">Zapytaj o ten pakiet</span>
                <span class="btn-text-short">Wybierz</span>
              </a>
            </article>
          </div>
        </div>
      </div>

      <div class="offer-category">
        <button type="button" class="offer-category-head" aria-expanded="false">
          <span class="block-label">Reportaże</span>
          <span class="offer-category-title">Reportaże z wydarzeń</span>
          <span class="offer-toggle" aria-hidden="true"></span>
        </button>
        <div class="offer-category-body">
          <div class="offer-grid offer-grid--ranges">
            <article class="offer-card">
              <p class="block-label">Ślubne</p>
              <p class="offer-price">2800–8500 zł</p>
              <p class="offer-note">Widełki cenowe</p>
              <ul>
                <li>Przygotowania, ceremonia, wesele</li>
                <li>Zakres ustalany indywidualnie</li>
                <li>Galeria online dla gości</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="slubne" data-pakiet="indywidualna">
                <span class="btn-text-long">Zapytaj o wycenę</span>
                <span class="btn-text-short">Wycena</span>
              </a>
            </article>
            <article class="offer-card offer-card--featured">
              <span class="offer-badge">Popularne</span>
              <p class="block-label">Komunie</p>
              <p class="offer-price">800–2000 zł</p>
              <p class="offer-note">Widełki cenowe</p>
              <ul>
                <li>Uroczystość i przyjęcie</li>
                <li>Zdjęcia rodzinne i reportaż</li>
                <li>Czas trwania do uzgodnienia</li>
              </ul>
              <a href="#kontakt" class="btn btn-primary js-fill-form" data-tematyka="komunie" data-pakiet="indywidualna">
                <span class="btn-text-long">Zapytaj o wycenę</span>
                <span class="btn-text-short">Wycena</span>
              </a>
            </article>
            <article class="offer-card">
              <p class="block-label">Eventy</p>
              <p class="offer-price">700–2500 zł</p>
              <p class="offer-note">Widełki cenowe</p>
              <ul>
                <li>Konferencje, imprezy, gale</li>
                <li>Cena zależy od długości wydarzenia</li>
                <li>Zdjęcia do publikacji</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="eventy" data-pakiet="indywidualna">
                <span class="btn-text-long">Zapytaj o wycenę</span>
                <span class="btn-text-short">Wycena</span>
              </a>
            </article>
            <article class="offer-card">
              <p class="block-label">Sport</p>
              <p class="offer-price">600–2200 zł</p>
              <p class="offer-note">Widełki cenowe</p>
              <ul>
                <li>Zawody, mecze, relacje</li>
                <li>Cena zależy od miejsca i czasu</li>
                <li>Kadry do mediów i social mediów</li>
              </ul>
              <a href="#kontakt" class="btn btn-secondary js-fill-form" data-tematyka="sport" data-pakiet="indywidualna">
                <span class="btn-text-long">Zapytaj o wycenę</span>
                <span class="btn-text-short">Wycena</span>
              </a>
            </article>
          </div>
          <p class="offer-disclaimer">
            Podane kwoty to orientacyjne widełki, a nie stały cennik. Ostateczna wycena jest zawsze indywidualna
            i zależy od podkategorii, liczby godzin, liczby fotografów, lokalizacji oraz zakresu zdjęć.
            Po krótkiej rozmowie przygotuję konkretną ofertę.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section about-section" id="o-mnie">
    <div class="section-inner">
      <h2 class="section-title">O mnie</h2>
      <p class="section-lead">Kilka słów o tym, kto stoi za obiektywem.</p>
      <div class="about-grid">
        <figure class="about-photo">
          <img src="/zdjecia/o-mnie/portret.jpg" alt="Fotografka z aparatem" />
        </figure>
        <div class="about-text">
          <p class="block-label">Obiektyw na Szczęście</p>
          <h3>Uwieczniam chwile, które chcesz zapamiętać.</h3>
          <p>
            Kocham naturalne światło, szczere emocje i zdjęcia, które nie pozują — tylko opowiadają historię.
            Pracuję spokojnie, bez pośpiechu, tak żebyście mogli być sobą przed aparatem.
          </p>
          <p>
            Robię sesje biznesowe, portretowe i reportaże z wydarzeń. Każde zlecenie traktuję indywidualnie:
            od rozmowy o oczekiwaniach, przez zdjęcia, aż po starannie wybrane kadry gotowe do publikacji.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section contact-section" id="kontakt">
    <div class="section-inner">
      <h2 class="section-title">Kontakt</h2>
      <p class="section-lead">Napisz, jaki rodzaj sesji Cię interesuje — odezwę się z propozycją terminu.</p>
      <div class="contact-grid">
        <form class="contact-form" id="contact-form" autocomplete="off">
          <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" hidden />
          <label class="form-field">
            <span>Tematyka zdjęć</span>
            <select name="tematyka" id="tematyka" required>
              <option value="" disabled selected>Wybierz kategorię</option>
              <option value="portretowa">Sesja portretowa</option>
              <option value="biznesowa">Sesja biznesowa</option>
              <optgroup label="Reportaże z wydarzeń">
                <option value="slubne">Ślubne</option>
                <option value="komunie">Komunijne</option>
                <option value="eventy">Eventy</option>
                <option value="sport">Sport</option>
              </optgroup>
            </select>
          </label>
          <label class="form-field">
            <span>Pakiet</span>
            <select name="pakiet" id="pakiet" required disabled>
              <option value="" disabled selected>Najpierw wybierz tematykę</option>
            </select>
          </label>
          <label class="form-field">
            <span>Numer telefonu (opcjonalnie)</span>
            <div class="phone-input">
              <span class="phone-prefix">+48</span>
              <input type="tel" name="telefon" id="telefon" inputmode="numeric" autocomplete="tel-national" maxlength="9" pattern="[0-9]{9}" placeholder="123 456 789" title="Podaj 9 cyfr albo zostaw puste" />
            </div>
          </label>
          <p class="form-hint">Numer telefonu jest opcjonalny, ale ułatwi kontakt i dogadanie oferty. Wpisz 9 cyfr — kierunkowy +48 jest stały.</p>
          <label class="form-field">
            <span>Wiadomość</span>
            <textarea name="wiadomosc" rows="5" required placeholder="Napisz, czego potrzebujesz i jaki termin Ci pasuje."></textarea>
          </label>
          <label class="form-check">
            <input type="checkbox" name="rodo" required />
            <span>
              Wyrażam zgodę na przetwarzanie moich danych osobowych w celu odpowiedzi na zapytanie
              zgodnie z <a href="/polityka-prywatnosci">Polityką prywatności</a>.
            </span>
          </label>
          <button type="submit" class="btn btn-primary" id="form-submit">Wyślij zapytanie</button>
          <p class="form-success" id="form-success" hidden>Dziękuję. Zapytanie zostało wysłane — odezwę się tak szybko, jak to możliwe.</p>
          <p class="form-error" id="form-error" hidden></p>
          <p class="rodo-note">
            Administratorem danych jest Obiektyw na Szczęście. Przetwarzamy tematykę, pakiet i treść wiadomości,
            a numer telefonu tylko jeśli go podasz. Dane służą obsłudze zapytania. Masz prawo dostępu do danych,
            ich sprostowania, usunięcia, ograniczenia przetwarzania oraz wniesienia sprzeciwu.
            Podanie wiadomości jest niezbędne do kontaktu zwrotnego. Szczegóły znajdziesz w
            <a href="/polityka-prywatnosci">Polityce prywatności</a>.
          </p>
        </form>
        <aside class="contact-aside">
          <div class="contact-card contact-card--phone">
            <p class="block-label">Telefon</p>
            <a href={`tel:${PHONE}`}>{PHONE_LABEL}</a>
          </div>
          <div class="contact-card contact-card--instagram">
            <p class="block-label">Instagram</p>
            <InstagramLink />
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initHomePage } from '../scripts/home.js';
  initHomePage();
</script>
