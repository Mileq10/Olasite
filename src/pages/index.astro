---
import Layout from '../layouts/Layout.astro';
import InstagramLink from '../components/InstagramLink.astro';
import { offerCatalogJsonLd, offerCategories, PRICE_RANGE } from '../data/offer.js';
import { TURNSTILE_SITE_KEY } from '../lib/form-config.js';
import { FORM_TOPICS } from '../lib/contact-schema.js';
import { faqJsonLd, faqs } from '../data/faq.js';
import {
  SITE_NAME,
  DEFAULT_DESCRIPTION,
  EMAIL_TO,
  PHONE,
  PHONE_LABEL,
  INSTAGRAM_URL,
  OG_IMAGE_ALT
} from '../lib/site.js';

const pageUrl = new URL('/', Astro.site ?? Astro.url).href;
const topicGroups = [...new Set(FORM_TOPICS.map((topic) => topic.group).filter(Boolean))];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE_NAME,
    description: DEFAULT_DESCRIPTION,
    url: pageUrl,
    email: EMAIL_TO,
    telephone: PHONE,
    image: new URL('/og.jpg', Astro.site ?? Astro.url).href,
    sameAs: [INSTAGRAM_URL],
    areaServed: 'PL',
    priceRange: PRICE_RANGE,
    serviceType: ['Fotografia portretowa', 'Fotografia biznesowa', 'Reportaż'],
    hasOfferCatalog: offerCatalogJsonLd(new URL('/#oferta', Astro.site ?? Astro.url).href)
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    url: pageUrl,
    inLanguage: 'pl-PL'
  },
  faqJsonLd()
];
---

<Layout
  title={`Fotograf sesji i reportaży | ${SITE_NAME}`}
  description={DEFAULT_DESCRIPTION}
  imageAlt={OG_IMAGE_ALT}
  preloadImage={true}
  jsonLd={jsonLd}
>
  <section class="hero-section" id="home">
    <img
      class="hero-bg"
      src="/zdjecia/hero/tlo.jpg"
      alt=""
      width="1920"
      height="1282"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-overlay"></div>
    <div class="container">
      <div class="hero-content">
        <div class="hero-text">
          <h1>Przeżywaj wspaniałe chwile i pozwól mi je uwiecznić.</h1>
          <p>
            Fotografuję sesje portretowe, biznesowe i reportaże z wydarzeń.
            Naturalne światło, szczere emocje i kadry, które zostają z Wami na dłużej.
          </p>
          <div class="hero-buttons">
            <a href="#kontakt" class="btn btn-primary">Umów się na sesję</a>
            <a href="#portfolio" class="btn btn-secondary">Zobacz więcej zdjęć</a>
          </div>
        </div>
        <div class="hero-gallery">
          <div class="gallery-item item-1">
            <img src="/zdjecia/hero/1.jpg" alt="Rodzina na sesji plenerowej" width="800" height="1000" decoding="async" />
          </div>
          <div class="gallery-item item-2">
            <img src="/zdjecia/hero/2.jpg" alt="Portret kobiety w studyjnym świetle" width="800" height="1000" decoding="async" />
          </div>
          <div class="gallery-item item-3">
            <img src="/zdjecia/hero/3.jpg" alt="Portret kobiety w ogrodzie" width="1200" height="800" decoding="async" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="categories-section" id="portfolio" data-reveal>
    <div class="section-inner">
      <h2 class="section-title">Portfolio</h2>
      <p class="section-lead">Wybierz kategorię, żeby zobaczyć zdjęcia z sesji i reportaży.</p>
      <div class="portfolio-block">
        <p class="block-label">Kategorie sesji</p>
        <div class="categories-grid">
          <article class="category-card">
            <a href="/galeria/biznesowa" class="category-image">
              <img src="/zdjecia/portfolio/biznesowa/okladka.jpg" alt="Sesja biznesowa" width="900" height="1200" loading="lazy" decoding="async" />
              <span class="category-caption">
                <span class="category-name">Sesja biznesowa</span>
                <span class="category-hint">Zobacz galerię</span>
              </span>
            </a>
          </article>
          <article class="category-card">
            <a href="/galeria/portretowa" class="category-image">
              <img src="/zdjecia/portfolio/portretowa/okladka.jpg" alt="Sesja portretowa" width="900" height="1200" loading="lazy" decoding="async" />
              <span class="category-caption">
                <span class="category-name">Sesja portretowa</span>
                <span class="category-hint">Zobacz galerię</span>
              </span>
            </a>
          </article>
          <article class="category-card">
            <a href="/galeria/wydarzenia" class="category-image">
              <img src="/zdjecia/portfolio/wydarzenia/okladka.jpg" alt="Reportaże z wydarzeń" width="900" height="1200" loading="lazy" decoding="async" />
              <span class="category-caption">
                <span class="category-name">Reportaże z wydarzeń</span>
                <span class="category-hint">Zobacz galerię</span>
              </span>
            </a>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section offer-section" id="oferta" data-reveal>
    <div class="section-inner">
      <h2 class="section-title">Oferta</h2>
      <p class="section-lead">Stałe pakiety na sesje portretowe i biznesowe. Reportaże wyceniam indywidualnie w podanych widełkach.</p>

      {offerCategories.map((category) => (
        <div class="offer-category">
          <button
            type="button"
            class="offer-category-head"
            id={category.id}
            aria-controls={`${category.id}-panel`}
            aria-expanded="true"
          >
            <span class="block-label">{category.label}</span>
            <span class="offer-category-title">{category.title}</span>
            <span class="offer-toggle" aria-hidden="true"></span>
          </button>
          <div class="offer-category-body" id={`${category.id}-panel`} role="region" aria-labelledby={category.id}>
            <div class:list={['offer-grid', category.ranges && 'offer-grid--ranges']}>
              {category.packages.map((pkg) => (
                <article class:list={['offer-card', pkg.featured && 'offer-card--featured']}>
                  {pkg.badge && <span class="offer-badge">{pkg.badge}</span>}
                  <p class="block-label">{pkg.name}</p>
                  <p class="offer-price">{pkg.priceLabel}</p>
                  {pkg.note && <p class="offer-note">{pkg.note}</p>}
                  <ul>
                    {pkg.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                  <a
                    href="#kontakt"
                    class:list={['btn', pkg.featured ? 'btn-primary' : 'btn-secondary', 'js-fill-form']}
                    data-tematyka={pkg.tematyka}
                    data-pakiet={pkg.pakiet}
                    aria-label={`${pkg.ctaLong}: ${category.title}, pakiet ${pkg.name}`}
                  >
                    <span class="btn-text-long">{pkg.ctaLong}</span>
                    <span class="btn-text-short" aria-hidden="true">{pkg.ctaShort}</span>
                  </a>
                </article>
              ))}
            </div>
            {category.disclaimer && <p class="offer-disclaimer">{category.disclaimer}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="content-section process-section" id="przebieg" data-reveal>
    <div class="section-inner">
      <h2 class="section-title">Jak to wygląda</h2>
      <p class="section-lead">Od pierwszej wiadomości do gotowych kadrów. Bez ukrytych etapów.</p>
      <ol class="process-steps">
        <li>
          <span>1</span>
          <h3>Kontakt</h3>
          <p>Piszesz, jakiej sesji potrzebujesz, albo dzwonisz.</p>
        </li>
        <li>
          <span>2</span>
          <h3>Rozmowa</h3>
          <p>Ustalamy oczekiwania, termin i zakres zdjęć.</p>
        </li>
        <li>
          <span>3</span>
          <h3>Zdjęcia</h3>
          <p>Sesja albo reportaż, spokojnie i bez pośpiechu.</p>
        </li>
        <li>
          <span>4</span>
          <h3>Kadry</h3>
          <p>Dostajesz wybrane zdjęcia i galerię online.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="content-section faq-section" id="pytania" data-reveal>
    <div class="section-inner">
      <h2 class="section-title">Pytania</h2>
      <p class="section-lead">Krótko o cenach i o tym, jak się umówić. Szczegóły pakietów są w ofercie.</p>
      <div class="faq-list">
        {faqs.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section about-section" id="o-mnie" data-reveal>
    <div class="section-inner">
      <h2 class="section-title">O mnie</h2>
      <p class="section-lead">Kilka słów o tym, kto stoi za obiektywem.</p>
      <div class="about-grid">
        <figure class="about-photo">
          <img src="/zdjecia/o-mnie/portret.jpg" alt="Fotografka z aparatem" width="900" height="1200" loading="lazy" decoding="async" />
        </figure>
        <div class="about-text">
          <p class="block-label">Obiektyw na Szczęście</p>
          <h3>Uwieczniam chwile, które chcesz zapamiętać.</h3>
          <p>
            Kocham naturalne światło, szczere emocje i zdjęcia, które nie pozują — tylko opowiadają historię.
            Pracuję spokojnie, bez pośpiechu, tak żebyście mogli być sobą przed aparatem.
          </p>
          <p>
            Robię sesje biznesowe, portretowe i reportaże z wydarzeń. Każde zlecenie traktuję indywidualnie:
            od rozmowy o oczekiwaniach, przez zdjęcia, aż po starannie wybrane kadry gotowe do publikacji.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="content-section contact-section" id="kontakt" data-reveal>
    <div class="section-inner">
      <h2 class="section-title">Kontakt</h2>
      <p class="section-lead">Napisz, jaki rodzaj sesji Cię interesuje — odezwę się z propozycją terminu.</p>
      <div class="contact-grid">
        <form
          class="contact-form"
          id="contact-form"
          autocomplete="on"
          novalidate
          data-contact-email={EMAIL_TO}
          data-contact-phone={PHONE}
          data-contact-phone-label={PHONE_LABEL}
          data-turnstile-sitekey={TURNSTILE_SITE_KEY}
        >
          <div class="hp" inert>
            <label for="fax_number">Nie wypełniaj tego pola</label>
            <input type="text" id="fax_number" name="fax_number" tabindex="-1" autocomplete="off" maxlength="80" />
          </div>
          <div id="form-error-summary" class="form-error-summary" role="alert" tabindex="-1" hidden></div>
          <div class="form-field" data-field="tematyka">
            <label for="tematyka">Tematyka zdjęć <span class="req" aria-hidden="true">*</span><span class="visually-hidden"> wymagane</span></label>
            <select name="tematyka" id="tematyka" required aria-required="true" aria-describedby="error-tematyka">
              <option value="" disabled selected>Wybierz kategorię</option>
              {FORM_TOPICS.filter((topic) => !topic.group).map((topic) => (
                <option value={topic.value}>{topic.label}</option>
              ))}
              {topicGroups.map((group) => (
                <optgroup label={group}>
                  {FORM_TOPICS.filter((topic) => topic.group === group).map((topic) => (
                    <option value={topic.value}>{topic.label}</option>
                  ))}
                </optgroup>
              ))}
            </select>
            <p class="field-error" id="error-tematyka" hidden></p>
          </div>
          <div class="form-field" data-field="pakiet">
            <label for="pakiet">Pakiet <span class="req" aria-hidden="true">*</span><span class="visually-hidden"> wymagane</span></label>
            <select name="pakiet" id="pakiet" required aria-required="true" disabled aria-describedby="error-pakiet">
              <option value="" disabled selected>Najpierw wybierz tematykę</option>
            </select>
            <p class="field-error" id="error-pakiet" hidden></p>
          </div>
          <div class="form-field" data-field="email">
            <label for="email">Adres e-mail <span class="req" aria-hidden="true">*</span><span class="visually-hidden"> wymagane</span></label>
            <input
              type="email"
              name="email"
              id="email"
              required
              aria-required="true"
              maxlength="120"
              autocomplete="email"
              inputmode="email"
              placeholder="np. jan@example.com"
              aria-describedby="error-email"
            />
            <p class="field-error" id="error-email" hidden></p>
          </div>
          <div class="form-field" data-field="telefon">
            <label for="telefon">Numer telefonu (opcjonalnie)</label>
            <div class="phone-input">
              <span class="phone-prefix">+48</span>
              <input
                type="tel"
                name="telefon"
                id="telefon"
                inputmode="numeric"
                autocomplete="tel-national"
                maxlength="11"
                placeholder="123 123 123"
                aria-describedby="error-telefon form-hint-telefon"
              />
            </div>
            <p class="field-error" id="error-telefon" hidden></p>
          </div>
          <p class="form-hint" id="form-hint-telefon">Numer jest opcjonalny.</p>
          <div class="form-field" data-field="wiadomosc">
            <label for="wiadomosc">Wiadomość <span class="req" aria-hidden="true">*</span><span class="visually-hidden"> wymagane</span></label>
            <textarea id="wiadomosc" name="wiadomosc" rows="5" required aria-required="true" maxlength="2000" placeholder="Napisz, czego potrzebujesz i jaki termin Ci pasuje." aria-describedby="error-wiadomosc"></textarea>
            <p class="field-error" id="error-wiadomosc" hidden></p>
          </div>
          <p class="form-disclaimer">
            Wysyłając zapytanie, prosisz o odpowiedź w sprawie sesji. Zasady przetwarzania danych opisuje
            <a href="/polityka-prywatnosci">Polityka prywatności</a>.
          </p>
          <div id="turnstile-slot" class="turnstile-slot"></div>
          <button type="submit" class="btn btn-primary" id="form-submit">Wyślij zapytanie</button>
          <p class="form-success" id="form-success" hidden role="status" aria-live="polite">
            <strong>Wiadomość wysłana.</strong>
            Dziękuję za zapytanie — odezwę się tak szybko, jak to możliwe.
          </p>
          <p class="form-error" id="form-error" hidden role="alert"></p>
          <p class="rodo-note">
            Administratorem danych jest Obiektyw na Szczęście. W sprawie danych napisz na
            <a href={`mailto:${EMAIL_TO}`}>{EMAIL_TO}</a>.
            Przetwarzamy tematykę, pakiet, adres e-mail i treść wiadomości, a numer telefonu tylko jeśli go podasz,
            żeby odpowiedzieć na zapytanie (art. 6 ust. 1 lit. b i f RODO).
            Korespondencję bez współpracy przechowujemy przez 12 miesięcy od ostatniego kontaktu.
            Szczegóły, w tym odbiorca Web3Forms, są w
            <a href="/polityka-prywatnosci">Polityce prywatności</a>.
          </p>
        </form>
        <aside class="contact-aside">
          <div class="contact-card contact-card--phone">
            <p class="block-label">Telefon</p>
            <a href={`tel:${PHONE}`}>{PHONE_LABEL}</a>
          </div>
          <div class="contact-card contact-card--instagram">
            <p class="block-label">Instagram</p>
            <InstagramLink />
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initHomePage } from '../scripts/home.js';
  initHomePage();
</script>
