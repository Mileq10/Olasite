---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CSP_META } from '../lib/csp.js';
import { SITE_NAME, DEFAULT_DESCRIPTION, DEFAULT_OG_IMAGE, OG_IMAGE_WIDTH, OG_IMAGE_HEIGHT, OG_IMAGE_ALT, PHONE } from '../lib/site.js';

const {
  title = SITE_NAME,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  imageWidth = OG_IMAGE_WIDTH,
  imageHeight = OG_IMAGE_HEIGHT,
  imageAlt = OG_IMAGE_ALT,
  preloadImage = false,
  type = 'website',
  noindex = false,
  jsonLd
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const imageUrl = new URL(image, canonical).href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow';
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdHtml = (data) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE_NAME} />
    <meta name="theme-color" content="#1a1a1a" />
    <meta http-equiv="Content-Security-Policy" content={CSP_META} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {jsonLdList.map((data) => (
      <script is:inline type="application/ld+json" set:html={jsonLdHtml(data)} />
    ))}

    {preloadImage && <link rel="preload" as="image" href={image} fetchpriority="high" />}
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <div class="mobile-actions">
      <a href={`tel:${PHONE}`}>Zadzwoń</a>
      <a href="/#kontakt">Napisz</a>
    </div>
    <button class="to-top" id="to-top" type="button" hidden>Do góry</button>
    <script>
      import '../scripts/nav.js';
    </script>
  </body>
</html>
